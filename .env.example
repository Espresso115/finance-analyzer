# MongoDB (Atlas or existing external cluster)
MONGODB_URI=

# Redis (Upstash or Redis Cloud)
REDIS_URL=

# LLM Provider (gemini or groq)
LLM_PROVIDER=gemini

# Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=

# Groq configuration (fallback)
GROQ_API_KEY=
GROQ_MODEL=

# Chroma Vector Database Persist Directory (absolute or relative to llm-service)
CHROMA_PERSIST_DIR=./data/chroma
